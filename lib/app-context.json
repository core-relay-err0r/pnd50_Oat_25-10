{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "lastUpdated": "2025-01-14",

  "application": {
    "name": "PND50",
    "tagline": "AI Boutique Accounting & Consultant",
    "type": "Full-stack Next.js Business Website",
    "framework": "Next.js 16 (App Router)",
    "language": "TypeScript",
    "styling": "Tailwind CSS v4 + shadcn/ui",
    "database": "Supabase (PostgreSQL)",
    "deployment": "Vercel"
  },

  "businessContext": {
    "industry": "Accounting & Consulting Services",
    "location": "Bangkok, Thailand",
    "targetAudience": [
      "Foreign entrepreneurs starting businesses in Thailand",
      "Expats running companies in Thailand",
      "International companies expanding to Thailand",
      "Companies from Singapore, Russia, Taiwan, China"
    ],
    "companyInfo": {
      "legalName": "PND50 Co., Ltd.",
      "founded": "2014",
      "email": "info@pnd50.com",
      "phone": "+66-2-017-2949",
      "address": "Bhiraj Tower at EmQuartier, 689 Sukhumvit Rd, Khlong Tan Nuea, Watthana, Bangkok 10110, Thailand"
    }
  },

  "coreServices": {
    "accounting": {
      "name": "Accounting & Bookkeeping",
      "description": "Monthly/quarterly bookkeeping, financial statements, Thai accounting standards compliance",
      "route": "/services/accounting"
    },
    "tax": {
      "name": "Tax Filing & Compliance",
      "description": "PND50 (annual corporate tax), PND51 (half-year tax), VAT filing, withholding tax",
      "route": "/services/tax"
    },
    "payroll": {
      "name": "Payroll Services",
      "description": "Salary processing, social security, personal income tax (PND1), provident fund",
      "route": "/services/payroll"
    },
    "corporate": {
      "name": "Corporate Services",
      "description": "Company registration, BOI applications, work permits, business licenses",
      "route": "/services/corporate"
    },
    "advisory": {
      "name": "Business Advisory",
      "description": "Tax planning, financial analysis, business restructuring, M&A support",
      "route": "/services/advisory"
    },
    "growth": {
      "name": "Growth Solutions",
      "description": "CFO services, financial modeling, funding preparation, expansion strategy",
      "route": "/services/growth"
    }
  },

  "servicePackages": {
    "startup": {
      "name": "Startup Package",
      "description": "Essential services for new businesses - basic accounting, tax filing, compliance",
      "route": "/services/packages/startup"
    },
    "growth": {
      "name": "Growth Package",
      "description": "Expanding businesses - full accounting, tax optimization, HR support",
      "route": "/services/packages/growth"
    },
    "fullCycle": {
      "name": "Full-Cycle Package",
      "description": "Enterprise solution - complete financial management, strategic advisory, dedicated team",
      "route": "/services/packages/full-cycle"
    }
  },

  "pages": {
    "public": [
      {
        "route": "/",
        "name": "Homepage",
        "purpose": "Hero section with animated background, rotating testimonials, CTAs"
      },
      {
        "route": "/services",
        "name": "Services Overview",
        "purpose": "Grid of all services with descriptions and links"
      },
      { "route": "/about", "name": "About Us", "purpose": "Company story, team, values, achievements" },
      { "route": "/contact", "name": "Contact", "purpose": "Contact form, office info, map, business hours" },
      { "route": "/faq", "name": "FAQ", "purpose": "Frequently asked questions with accordion UI" },
      { "route": "/schedule", "name": "Schedule Consultation", "purpose": "Booking form for free consultations" },
      { "route": "/schedule/success", "name": "Booking Success", "purpose": "Confirmation page after scheduling" },
      { "route": "/case-studies", "name": "Case Studies", "purpose": "Client success stories and testimonials" },
      { "route": "/privacy-policy", "name": "Privacy Policy", "purpose": "Legal privacy policy document" },
      { "route": "/terms-of-service", "name": "Terms of Service", "purpose": "Legal terms and conditions" }
    ]
  },

  "features": {
    "aiChatbot": {
      "name": "Panida AI Assistant",
      "description": "Floating chatbot with voice input/output for customer support and service inquiries",
      "technology": "Vercel AI SDK, ElevenLabs TTS, Speech Recognition API",
      "capabilities": [
        "Answer questions about services",
        "Guide users to appropriate service pages",
        "Speak responses aloud (Thai/English)",
        "Voice input for hands-free interaction",
        "Persist chat history in Supabase"
      ],
      "routes": {
        "chat": "/api/chatbot",
        "tts": "/api/text-to-speech"
      }
    },
    "animations": {
      "library": "Framer Motion + GSAP",
      "features": [
        "Animated hero background with floating shapes",
        "Mouse-following parallax effects",
        "Rotating word carousel",
        "Scroll-triggered section animations",
        "Testimonial shuffle cards"
      ]
    },
    "seo": {
      "features": [
        "Structured data (Organization, LocalBusiness, WebSite schemas)",
        "Geo-targeted SEO for Thailand and international markets",
        "AI search optimization content",
        "Multi-language support (English/Thai)",
        "OpenGraph and Twitter cards"
      ]
    }
  },

  "database": {
    "provider": "Supabase",
    "tables": {
      "chat_sessions": {
        "purpose": "Store chatbot conversation sessions",
        "columns": ["id", "created_at", "updated_at", "title", "session_token"],
        "rls": true
      },
      "chat_messages": {
        "purpose": "Store individual chat messages",
        "columns": ["id", "created_at", "session_id", "role", "content", "metadata"],
        "rls": true
      },
      "profiles": {
        "purpose": "User profiles for interview/consultation features",
        "columns": [
          "id",
          "user_id",
          "name",
          "industry",
          "target_role",
          "experience",
          "skills",
          "resume",
          "job_description",
          "company_name",
          "company_info"
        ],
        "rls": true
      },
      "interview_sessions": {
        "purpose": "Track interview practice sessions",
        "columns": [
          "id",
          "user_id",
          "profile_id",
          "started_at",
          "ended_at",
          "questions_asked",
          "messages",
          "difficulty",
          "feedback",
          "overall_score",
          "strengths",
          "improvements"
        ],
        "rls": true
      }
    }
  },

  "apiRoutes": {
    "/api/chatbot": {
      "method": "POST",
      "purpose": "AI chatbot conversation endpoint",
      "technology": "Vercel AI SDK streamText",
      "model": "GPT-4o-mini via Vercel AI Gateway"
    },
    "/api/text-to-speech": {
      "method": "POST",
      "purpose": "Convert text to speech for voice responses",
      "technology": "ElevenLabs API",
      "voice": "Thai female voice"
    }
  },

  "integrations": {
    "vercel": {
      "analytics": true,
      "speedInsights": true
    },
    "google": {
      "analytics": "GA4",
      "searchConsole": true
    },
    "supabase": {
      "auth": false,
      "database": true,
      "realtime": false
    },
    "ai": {
      "provider": "Vercel AI Gateway",
      "models": ["gpt-4o-mini"],
      "tts": "ElevenLabs"
    }
  },

  "techStack": {
    "frontend": {
      "framework": "Next.js 16",
      "react": "19.x",
      "typescript": "5.x",
      "styling": ["Tailwind CSS v4", "shadcn/ui", "tw-animate-css"],
      "animations": ["Framer Motion", "GSAP"],
      "icons": "Lucide React"
    },
    "backend": {
      "runtime": "Next.js API Routes / Server Actions",
      "database": "Supabase PostgreSQL",
      "orm": "Direct SQL (no ORM)"
    },
    "ai": {
      "sdk": "Vercel AI SDK v5",
      "gateway": "Vercel AI Gateway",
      "tts": "ElevenLabs"
    }
  },

  "uniqueSellingPoints": [
    "English-speaking team for foreign businesses",
    "10+ years experience serving expat companies",
    "200+ clients with 99% satisfaction rate",
    "Transparent fixed-fee pricing",
    "AI-powered chatbot for 24/7 support",
    "Modern tech-driven accounting approach"
  ],

  "thaiContext": {
    "taxForms": {
      "PND50": "Annual corporate income tax return (ภ.ง.ด.50)",
      "PND51": "Half-year corporate tax return (ภ.ง.ด.51)",
      "PND1": "Monthly employee withholding tax (ภ.ง.ด.1)",
      "PP30": "Monthly VAT return (ภ.พ.30)"
    },
    "compliance": [
      "Thai Accounting Standards (TAS)",
      "Revenue Department regulations",
      "Social Security Fund contributions",
      "DBD (Department of Business Development) filings"
    ]
  }
}
